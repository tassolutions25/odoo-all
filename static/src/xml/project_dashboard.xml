<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ahadu_project_management.ProjectDashboard" owl="1">
        <div class="proj_dashboard_container">
            <div t-if="state.loading" class="proj_loading_spinner">
                <div class="proj_spinner"></div>
                <p class="mt-3">Loading dashboard data...</p>
            </div>

            <div t-if="state.error" class="alert alert-warning mx-4 mt-3">
                <i class="fa fa-exclamation-triangle me-2"></i>
                <strong>Notice:</strong> Using sample data. <span t-esc="state.error"></span>
            </div>

            <div t-if="!state.loading">
                <!-- Header -->
                <div class="proj_dashboard_header">
                    <h1 class="proj_dashboard_title">
                        <i class="fa fa-project-diagram me-2"></i>
                        Project Portfolio Dashboard
                    </h1>
                </div>

                <!-- Filter Bar -->
                <div class="proj_filter_bar">
                    <h5 class="proj_filter_label">
                        <i class="fa fa-filter me-2"></i>Filters
                    </h5>
                    <div class="proj_filters">
                        <select class="form-select" name="state" t-on-change="onFilterChange">
                            <option value="all" t-att-selected="state.filters.state === 'all'">All States</option>
                            <option value="draft" t-att-selected="state.filters.state === 'draft'">Draft</option>
                            <option value="submitted" t-att-selected="state.filters.state === 'submitted'">Submitted</option>
                            <option value="approved" t-att-selected="state.filters.state === 'approved'">Approved</option>
                            <option value="active" t-att-selected="state.filters.state === 'active'">Active</option>
                            <option value="closed" t-att-selected="state.filters.state === 'closed'">Closed</option>
                        </select>
                        <select class="form-select" name="department" t-on-change="onFilterChange">
                            <option value="all" t-att-selected="state.filters.department === 'all'">All Departments</option>
                            <t t-foreach="state.availableFilters.departments || []" t-as="dept" t-key="dept.id">
                                <option t-att-value="dept.id" t-esc="dept.name" t-att-selected="state.filters.department == dept.id"></option>
                            </t>
                        </select>
                        <select class="form-select" name="health" t-on-change="onFilterChange">
                            <option value="all" t-att-selected="state.filters.health === 'all'">All Health Status</option>
                            <option value="green" t-att-selected="state.filters.health === 'green'">On Track</option>
                            <option value="amber" t-att-selected="state.filters.health === 'amber'">At Risk</option>
                            <option value="red" t-att-selected="state.filters.health === 'red'">Critical</option>
                        </select>
                        <select class="form-select" name="priority" t-on-change="onFilterChange">
                            <option value="all" t-att-selected="state.filters.priority === 'all'">All Priorities</option>
                            <option value="high" t-att-selected="state.filters.priority === 'high'">High</option>
                            <option value="medium" t-att-selected="state.filters.priority === 'medium'">Medium</option>
                            <option value="low" t-att-selected="state.filters.priority === 'low'">Low</option>
                        </select>
                        <select class="form-select" name="date_range" t-on-change="onFilterChange">
                            <option value="all" t-att-selected="state.filters.date_range === 'all'">All Time</option>
                            <option value="this_year" t-att-selected="state.filters.date_range === 'this_year'">This Year</option>
                            <option value="last_year" t-att-selected="state.filters.date_range === 'last_year'">Last Year</option>
                            <option value="q1" t-att-selected="state.filters.date_range === 'q1'">Q1</option>
                            <option value="q2" t-att-selected="state.filters.date_range === 'q2'">Q2</option>
                            <option value="q3" t-att-selected="state.filters.date_range === 'q3'">Q3</option>
                            <option value="q4" t-att-selected="state.filters.date_range === 'q4'">Q4</option>
                        </select>
                    </div>
                </div>

                <div class="proj_dashboard_body">
                    <!-- Tabs -->
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button t-att-class="'nav-link' + (state.activeTab === 'overview' ? ' active' : '')"
                                    t-on-click="() => this.setActiveTab('overview')" type="button">
                                <i class="fa fa-tachometer-alt me-2"></i>Portfolio Overview
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button t-att-class="'nav-link' + (state.activeTab === 'budget' ? ' active' : '')"
                                    t-on-click="() => this.setActiveTab('budget')" type="button">
                                <i class="fa fa-dollar-sign me-2"></i>Budget Analysis
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button t-att-class="'nav-link' + (state.activeTab === 'risks' ? ' active' : '')"
                                    t-on-click="() => this.setActiveTab('risks')" type="button">
                                <i class="fa fa-exclamation-triangle me-2"></i>Risks &amp; Issues
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button t-att-class="'nav-link' + (state.activeTab === 'timeline' ? ' active' : '')"
                                    t-on-click="() => this.setActiveTab('timeline')" type="button">
                                <i class="fa fa-calendar-alt me-2"></i>Progress &amp; Timeline
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content pt-4">

                        <!-- ==================== OVERVIEW TAB ==================== -->
                        <div t-att-class="'tab-pane fade' + (state.activeTab === 'overview' ? ' show active' : '')">
                            <!-- KPI Cards Row 1: Project Status -->
                            <div class="row proj_kpi_section mb-4">
                                <div class="col-lg col-md-6 mb-3">
                                    <div class="proj_kpi_card card-total-proj">
                                        <div class="proj_kpi_icon"><i class="fa fa-folder-open"></i></div>
                                        <div class="proj_kpi_data">
                                            <div class="proj_kpi_value" t-esc="state.kpis.total_projects"></div>
                                            <div class="proj_kpi_label">Total Projects</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg col-md-6 mb-3">
                                    <div class="proj_kpi_card card-active-proj">
                                        <div class="proj_kpi_icon"><i class="fa fa-play-circle"></i></div>
                                        <div class="proj_kpi_data">
                                            <div class="proj_kpi_value" t-esc="state.kpis.active_projects"></div>
                                            <div class="proj_kpi_label">Active Projects</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg col-md-6 mb-3">
                                    <div class="proj_kpi_card card-on-track">
                                        <div class="proj_kpi_icon"><i class="fa fa-check-circle"></i></div>
                                        <div class="proj_kpi_data">
                                            <div class="proj_kpi_value" t-esc="state.kpis.on_track"></div>
                                            <div class="proj_kpi_label">On Track</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg col-md-6 mb-3">
                                    <div class="proj_kpi_card card-at-risk">
                                        <div class="proj_kpi_icon"><i class="fa fa-exclamation-circle"></i></div>
                                        <div class="proj_kpi_data">
                                            <div class="proj_kpi_value" t-esc="state.kpis.at_risk"></div>
                                            <div class="proj_kpi_label">At Risk</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg col-md-6 mb-3">
                                    <div class="proj_kpi_card card-critical-proj">
                                        <div class="proj_kpi_icon"><i class="fa fa-times-circle"></i></div>
                                        <div class="proj_kpi_data">
                                            <div class="proj_kpi_value" t-esc="state.kpis.critical"></div>
                                            <div class="proj_kpi_label">Critical</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Charts Row -->
                            <div class="row">
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-heartbeat me-2"></i>Project Health Status
                                        </h5>
                                        <div class="proj_chart_container">
                                            <canvas t-ref="healthStatusChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-tasks me-2"></i>Projects by Status
                                        </h5>
                                        <div class="proj_chart_container">
                                            <canvas t-ref="byStateChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-building me-2"></i>Projects by Department
                                        </h5>
                                        <div class="proj_chart_container">
                                            <canvas t-ref="byDepartmentChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-flag me-2"></i>Priority Breakdown
                                        </h5>
                                        <div class="proj_chart_container">
                                            <canvas t-ref="byPriorityChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ==================== BUDGET TAB ==================== -->
                        <div t-att-class="'tab-pane fade' + (state.activeTab === 'budget' ? ' show active' : '')">
                            <!-- Budget KPI Cards -->
                            <div class="row proj_kpi_section mb-4">
                                <div class="col-lg-4 col-md-6 mb-3">
                                    <div class="proj_kpi_card card-budget-total">
                                        <div class="proj_kpi_icon"><i class="fa fa-money-bill-wave"></i></div>
                                        <div class="proj_kpi_data">
                                            <div class="proj_kpi_value" t-esc="this.formatCurrency(state.kpis.total_budget)"></div>
                                            <div class="proj_kpi_label">Total Planned Budget</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-6 mb-3">
                                    <div class="proj_kpi_card card-budget-actual">
                                        <div class="proj_kpi_icon"><i class="fa fa-receipt"></i></div>
                                        <div class="proj_kpi_data">
                                            <div class="proj_kpi_value" t-esc="this.formatCurrency(state.kpis.total_actual_cost)"></div>
                                            <div class="proj_kpi_label">Total Actual Cost</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-6 mb-3">
                                    <div class="proj_kpi_card card-budget-variance">
                                        <div class="proj_kpi_icon"><i class="fa fa-chart-line"></i></div>
                                        <div class="proj_kpi_data">
                                            <div class="proj_kpi_value" t-esc="this.formatCurrency(state.kpis.budget_variance)"></div>
                                            <div class="proj_kpi_label">Budget Remaining</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-8 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-chart-bar me-2"></i>Budget: Planned vs Actual by Department
                                        </h5>
                                        <div class="proj_chart_container large">
                                            <canvas t-ref="budgetByDeptChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-chart-pie me-2"></i>Budget Utilization
                                        </h5>
                                        <div class="proj_chart_container large">
                                            <canvas t-ref="budgetUtilizationChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-balance-scale me-2"></i>Budget Variance by Project
                                            <small class="text-muted ms-2" style="font-size:0.8rem;">(Green = Under Budget, Red = Over Budget)</small>
                                        </h5>
                                        <div class="proj_chart_container">
                                            <canvas t-ref="budgetVarianceChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ==================== RISKS &amp; ISSUES TAB ==================== -->
                        <div t-att-class="'tab-pane fade' + (state.activeTab === 'risks' ? ' show active' : '')">
                            <!-- Risk KPI Cards -->
                            <div class="row proj_kpi_section mb-4">
                                <div class="col-lg-4 col-md-6 mb-3">
                                    <div class="proj_kpi_card card-risk">
                                        <div class="proj_kpi_icon"><i class="fa fa-shield-alt"></i></div>
                                        <div class="proj_kpi_data">
                                            <div class="proj_kpi_value" t-esc="state.kpis.open_risks"></div>
                                            <div class="proj_kpi_label">Open Risks</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-6 mb-3">
                                    <div class="proj_kpi_card card-issue">
                                        <div class="proj_kpi_icon"><i class="fa fa-bug"></i></div>
                                        <div class="proj_kpi_data">
                                            <div class="proj_kpi_value" t-esc="state.kpis.open_issues"></div>
                                            <div class="proj_kpi_label">Open Issues</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-6 mb-3">
                                    <div class="proj_kpi_card card-overdue">
                                        <div class="proj_kpi_icon"><i class="fa fa-clock"></i></div>
                                        <div class="proj_kpi_data">
                                            <div class="proj_kpi_value" t-esc="state.kpis.overdue_tasks"></div>
                                            <div class="proj_kpi_label">Overdue Tasks</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-6 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-shield-alt me-2"></i>Risks by Level
                                        </h5>
                                        <div class="proj_chart_container">
                                            <canvas t-ref="riskByLevelChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-bug me-2"></i>Issues by Severity
                                        </h5>
                                        <div class="proj_chart_container">
                                            <canvas t-ref="issuesBySeverityChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-tasks me-2"></i>Task Status Breakdown
                                        </h5>
                                        <div class="proj_chart_container">
                                            <canvas t-ref="taskCompletionChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ==================== TIMELINE TAB ==================== -->
                        <div t-att-class="'tab-pane fade' + (state.activeTab === 'timeline' ? ' show active' : '')">
                            <div class="row">
                                <div class="col-lg-5 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-calendar-check me-2"></i>Timeline Status
                                        </h5>
                                        <div class="proj_chart_container">
                                            <canvas t-ref="timelineStatusChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-7 mb-4">
                                    <div class="proj_chart_card">
                                        <h5 class="proj_chart_title">
                                            <i class="fa fa-chart-bar me-2"></i>Progress Distribution
                                        </h5>
                                        <div class="proj_chart_container">
                                            <canvas t-ref="progressDistributionChart"></canvas>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div><!-- /tab-content -->
                </div><!-- /proj_dashboard_body -->
            </div>
        </div>
    </t>
</templates>
