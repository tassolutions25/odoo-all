<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         FORM VIEW — Mitigation Details & Context
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_risk_mitigation_form" model="ir.ui.view">
        <field name="name">risk.mitigation.form</field>
        <field name="model">risk.mitigation</field>
        <field name="arch" type="xml">
            <form string="Risk Mitigation Action">
                <header>
                    <field name="progress_status" widget="statusbar"
                           statusbar_visible="open,in_progress,completed" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="action_plan" class="oe_edit_only"/>
                        <h1>
                            <field name="action_plan" placeholder="e.g. Upgrade firewalls to version 12.0"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Mitigation Planning">
                            <field name="risk_id" domain="[('state', '=', 'approved')]"
                                   options="{'no_create': True, 'no_open': False}"/>
                            <field name="timeline"/>
                            <field name="dependencies"/>
                        </group>
                        <group string="Execution Info">
                            <field name="time_actions_executed"/>
                            <field name="status" readonly="1" widget="badge"
                                   decoration-success="status == 'fully_addressed'"
                                   decoration-warning="status == 'partially_addressed'"
                                   decoration-danger="status == 'not_attained'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Detailed Action &amp; Execution Logs" name="tab_execution">
                            <group>
                                <field name="detailed_action" placeholder="Describe detailed implementation steps / checklist…"/>
                            </group>
                            <group string="Execution Checklist Checkboxes (Toggle items when executed)">
                                <field name="checklist_item_ids" nolabel="1">
                                    <list editable="bottom" create="false" delete="false">
                                        <field name="name" readonly="1"/>
                                        <field name="is_checked" string="Executed?" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </group>
                            <group>
                                <field name="action_executed" readonly="1" string="Action Executed Summary"/>
                            </group>
                        </page>
                        <page string="Risk Context Information" name="tab_context">
                            <group>
                                <group string="Risk Identification">
                                    <field name="branch_id"/>
                                    <field name="department_id"/>
                                    <field name="risk_owner_id"/>
                                </group>
                                <group string="Risk Ratings">
                                    <field name="inherent_risk_rating" widget="badge"
                                           decoration-danger="inherent_risk_rating in ('very_high', 'high')"
                                           decoration-warning="inherent_risk_rating == 'medium'"
                                           decoration-success="inherent_risk_rating in ('low', 'very_low')"/>
                                    <field name="residual_risk_rating" widget="badge"
                                           decoration-danger="residual_risk_rating in ('very_high', 'high')"
                                           decoration-warning="residual_risk_rating == 'medium'"
                                           decoration-success="residual_risk_rating in ('low', 'very_low')"/>
                                </group>
                            </group>
                            <group string="Risk Event Details">
                                <field name="risk_event" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter for audit trail -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         TREE VIEW
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_risk_mitigation_tree" model="ir.ui.view">
        <field name="name">risk.mitigation.tree</field>
        <field name="model">risk.mitigation</field>
        <field name="arch" type="xml">
            <list string="Risk Mitigations"
                  decoration-danger="progress_status == 'overdue'"
                  decoration-warning="progress_status == 'escalated'"
                  decoration-success="progress_status == 'completed'">
                <field name="action_plan"/>
                <field name="risk_id" string="Risk Entry (RIN)"/>
                <field name="branch_id"/>
                <field name="department_id"/>
                <field name="timeline"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'fully_addressed'"
                       decoration-warning="status == 'partially_addressed'"
                       decoration-danger="status == 'not_attained'"/>
                <field name="progress_status" widget="badge"
                       decoration-info="progress_status == 'open'"
                       decoration-warning="progress_status == 'in_progress'"
                       decoration-success="progress_status == 'completed'"
                       decoration-danger="progress_status == 'overdue'"
                       decoration-muted="progress_status == 'escalated'"/>
                <field name="risk_owner_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         KANBAN VIEW — Grouped by Attainment Status
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_risk_mitigation_kanban" model="ir.ui.view">
        <field name="name">risk.mitigation.kanban</field>
        <field name="model">risk.mitigation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="action_plan"/>
                <field name="risk_id"/>
                <field name="timeline"/>
                <field name="status"/>
                <field name="progress_status"/>
                <field name="risk_owner_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="action_plan"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>Risk: <field name="risk_id"/></div>
                                <div>Target: <field name="timeline"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="progress_status" widget="badge"
                                           decoration-info="progress_status == 'open'"
                                           decoration-warning="progress_status == 'in_progress'"
                                           decoration-success="progress_status == 'completed'"
                                           decoration-danger="progress_status == 'overdue'"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="risk_owner_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         SEARCH VIEW
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_risk_mitigation_search" model="ir.ui.view">
        <field name="name">risk.mitigation.search</field>
        <field name="model">risk.mitigation</field>
        <field name="arch" type="xml">
            <search string="Search Mitigations">
                <field name="action_plan"/>
                <field name="risk_id"/>
                <field name="branch_id"/>
                <field name="department_id"/>
                <field name="risk_owner_id"/>
                <field name="status"/>
                <field name="progress_status"/>
                
                <filter string="My Mitigations" name="my_mitigations" domain="[('risk_owner_id', '=', uid)]"/>
                <separator/>
                <filter string="Open" name="filter_open" domain="[('progress_status', '=', 'open')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('progress_status', '=', 'in_progress')]"/>
                <filter string="Overdue" name="filter_overdue" domain="[('progress_status', '=', 'overdue')]"/>
                <filter string="Completed" name="filter_completed" domain="[('progress_status', '=', 'completed')]"/>
                
                <separator/>
                <filter string="Fully Addressed" name="filter_fully_addressed" domain="[('status', '=', 'fully_addressed')]"/>
                <filter string="Not Attained" name="filter_not_attained" domain="[('status', '=', 'not_attained')]"/>

                <group expand="0" string="Group By">
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status (Attainment)" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Progress Status" name="group_progress" context="{'group_by': 'progress_status'}"/>
                    <filter string="Attached Risk" name="group_risk" context="{'group_by': 'risk_id'}"/>
                    <filter string="Risk Owner" name="group_owner" context="{'group_by': 'risk_owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         ACTION
         ══════════════════════════════════════════════════════════════════ -->
    <record id="action_risk_mitigation" model="ir.actions.act_window">
        <field name="name">Mitigation Controls</field>
        <field name="res_model">risk.mitigation</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your first risk mitigation action plan
            </p>
            <p>
                Track action plans, timelines, execution logs, and progress status
                for controls corresponding to approved bank risks.
            </p>
        </field>
    </record>

</odoo>
