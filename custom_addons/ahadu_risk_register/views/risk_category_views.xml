<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_risk_category_form" model="ir.ui.view">
            <field name="name">risk.category.form</field>
            <field name="model">risk.category</field>
            <field name="arch" type="xml">
                <form string="Risk Category">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="e.g. Credit Risk"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                                <field name="description" placeholder="Description of this category..."/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_risk_category_tree" model="ir.ui.view">
            <field name="name">risk.category.tree</field>
            <field name="model">risk.category</field>
            <field name="arch" type="xml">
                <list string="Risk Categories" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_risk_category" model="ir.actions.act_window">
            <field name="name">Risk Categories</field>
            <field name="res_model">risk.category</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new risk category
                </p>
            </field>
        </record>
    </data>
</odoo>
