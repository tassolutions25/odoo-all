<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         QWeb PDF Landscape Table Template — Risk Register Report
         ══════════════════════════════════════════════════════════════════ -->
    <template id="report_risk_register_table_document">
        <t t-call="web.html_container">
            <div class="page" style="font-family: Calibri, Arial, sans-serif; font-size: 8px; margin: 0; padding: 0;">
                
                <!-- Custom Styling for the Excel-like table -->
                <style>
                    .peach-title-block {
                        background-color: #FFCC99;
                        color: #3F3F76;
                        font-family: 'Calibri', sans-serif;
                        font-size: 11px;
                        font-weight: bold;
                        padding: 3px 6px;
                    }
                    table.risk-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 10px;
                        font-size: 8px;
                    }
                    table.risk-table th, table.risk-table td {
                        border: 0.5px solid #000000;
                        padding: 3px 4px;
                        vertical-align: middle;
                        word-wrap: break-word;
                    }
                    table.risk-table th {
                        font-family: 'Calibri', sans-serif;
                        font-weight: bold;
                        text-align: center;
                    }
                    .header-tan {
                        background-color: #D6D4CA;
                        color: #000000;
                    }
                    .header-blue-gray {
                        background-color: #D2DAE4;
                        color: #000000;
                    }
                    .header-light-gray {
                        background-color: #F2F2F2;
                        color: #000000;
                    }
                    .header-normal-white {
                        background-color: #FFFFFF;
                        color: #000000;
                    }
                    .cell-center {
                        text-align: center;
                    }
                    .cell-left {
                        text-align: left;
                    }
                </style>

                <!-- ── Top Header Block ── -->
                <t t-set="company" t-value="res_company or (docs and docs.env.company)"/>
                <t t-set="fy_label" t-value="docs[0].get_fiscal_year_label() if docs else 'FY 2025/26'"/>

                <table style="width: 100%; border: none; margin-bottom: 8px;">
                    <tr style="border: none;">
                        <!-- Column B: Company Logo -->
                        <td style="width: 12%; border: none; text-align: center; vertical-align: middle;">
                            <t t-if="company and company.logo">
                                <img t-att-src="image_data_uri(company.logo)" style="max-height: 55px; max-width: 95px;"/>
                            </t>
                            <t t-else="">
                                <img src="/ahadu_risk_register/static/src/img/logo.jpeg" style="max-height: 50px; max-width: 90px;"/>
                            </t>
                        </td>
                        <!-- Column C: Title Information -->
                        <td style="width: 88%; border: none; vertical-align: middle;">
                            <div class="peach-title-block">Ahadu Bank S.C.</div>
                            <div class="peach-title-block" style="margin-top: 2px;">Risk Register Template</div>
                            <div class="peach-title-block" style="margin-top: 2px;"><t t-esc="fy_label"/></div>
                        </td>
                    </tr>
                    <tr style="border: none;">
                        <td style="border: none;"></td>
                        <td style="border: none; padding-top: 3px;">
                            <!-- Column C Row 4: Department/Work Unit Name -->
                            <div class="peach-title-block" style="width: 50%;">
                                Department/Work Unit's Name: <t t-esc="context.get('pdf_work_unit', 'All Departments')"/>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- ── Data Table ── -->
                <table class="risk-table">
                    <thead>
                        <!-- Row 5: Section headers -->
                        <tr>
                            <th colspan="5" class="header-tan" style="font-size: 9px; vertical-align: middle;">RISK IDENTIFICATION</th>
                            <th colspan="3" rowspan="2" class="header-blue-gray" style="font-size: 9px; vertical-align: middle;">INHERENT RISK ASSESSMENT</th>
                            <th rowspan="3" class="header-tan" style="font-size: 9px; width: 12%; vertical-align: middle;">Existing Mitigation/control</th>
                            <th colspan="3" rowspan="2" class="header-blue-gray" style="font-size: 9px; vertical-align: middle;">Existing control Assessment</th>
                            <th rowspan="3" class="header-blue-gray" style="font-size: 9px; width: 6%; vertical-align: middle;">Residual Risk Rating</th>
                            <th colspan="2" class="header-tan" style="font-size: 9px; vertical-align: middle;"></th>
                            <th colspan="2" class="header-tan" style="font-size: 9px; vertical-align: middle;">RISK MONITORING &amp; REVIEW</th>
                        </tr>
                        <!-- Row 6-7: Column Labels -->
                        <tr>
                            <th rowspan="2" class="header-tan" style="width: 3%; vertical-align: middle;">RIN</th>
                            <th rowspan="2" class="header-tan" style="width: 10%; vertical-align: middle;">Business objectives</th>
                            <th rowspan="2" class="header-tan" style="width: 13%; vertical-align: middle;">Business Processes/Activities or Risk Area</th>
                            <th rowspan="2" class="header-tan" style="width: 16%; vertical-align: middle;">Risk Event</th>
                            <th rowspan="2" class="header-tan" style="width: 12%; vertical-align: middle;">Cause</th>
                            
                            <th rowspan="2" class="header-light-gray" style="width: 12%; vertical-align: middle;">Additional Mitigation/Control Action</th>
                            <th rowspan="2" class="header-light-gray" style="width: 7%; vertical-align: middle;">Key Risk Indicator (KRI)</th>
                            <th rowspan="2" class="header-light-gray" style="width: 6%; vertical-align: middle;">Risk Owner</th>
                            <th rowspan="2" class="header-light-gray" style="width: 5%; vertical-align: middle;">Progress</th>
                        </tr>
                        <!-- Row 7: Sub-headers for Likelihood/Impact/Rating and Adequacy/Effectiveness/Control -->
                        <tr>
                            <th class="header-tan" style="font-size: 9px; vertical-align: middle;">Likelihood</th>
                            <th class="header-tan" style="font-size: 9px; vertical-align: middle;">Impact</th>
                            <th class="header-tan" style="font-size: 9px; vertical-align: middle;">Risk Rating</th>
                            <th class="header-normal-white" style="font-size: 9px; vertical-align: middle;">Adequacy</th>
                            <th class="header-normal-white" style="font-size: 9px; vertical-align: middle;">Effectiveness</th>
                            <th class="header-tan" style="font-size: 9px; vertical-align: middle;">Control strength</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="sr_no" t-value="1"/>
                        <t t-foreach="docs" t-as="risk">
                            <tr>
                                <!-- RIN -->
                                <td class="cell-center" style="font-weight: bold;"><t t-esc="risk.name"/></td>
                                
                                <!-- Business Objectives -->
                                <td class="cell-left"><t t-esc="risk.business_objective"/></td>
                                
                                <!-- Business Processes -->
                                <td class="cell-left"><t t-esc="risk.business_process"/></td>
                                
                                <!-- Risk Event -->
                                <td class="cell-left" style="font-weight: bold;"><t t-esc="risk.risk_event"/></td>
                                
                                <!-- Cause (Root Cause) -->
                                <td class="cell-left"><t t-esc="risk.root_cause"/></td>

                                <!-- Likelihood (color-coded) -->
                                <t t-set="l_val" t-value="int(risk.likelihood) if risk.likelihood else 0"/>
                                <td class="cell-center" t-attf-style="background-color: {{risk.get_rating_color('likelihood')}}; color: {{risk.get_rating_text_color('likelihood')}}; font-weight: bold;">
                                    <t t-if="l_val == 5">Almost Certain (5)</t>
                                    <t t-elif="l_val == 4">Likely (4)</t>
                                    <t t-elif="l_val == 3">Possible (3)</t>
                                    <t t-elif="l_val == 2">Unlikely (2)</t>
                                    <t t-elif="l_val == 1">Rare (1)</t>
                                </td>

                                <!-- Impact (color-coded) -->
                                <t t-set="i_val" t-value="int(risk.impact) if risk.impact else 0"/>
                                <td class="cell-center" t-attf-style="background-color: {{risk.get_rating_color('impact')}}; color: {{risk.get_rating_text_color('impact')}}; font-weight: bold;">
                                    <t t-if="i_val == 5">Critical (5)</t>
                                    <t t-elif="i_val == 4">Major (4)</t>
                                    <t t-elif="i_val == 3">Moderate (3)</t>
                                    <t t-elif="i_val == 2">Minor (2)</t>
                                    <t t-elif="i_val == 1">Insignificant (1)</t>
                                </td>

                                <!-- Risk Rating (color-coded) -->
                                <td class="cell-center" t-attf-style="background-color: {{risk.get_rating_color('inherent')}}; color: {{risk.get_rating_text_color('inherent')}}; font-weight: bold;">
                                    <t t-if="risk.inherent_risk_rating == 'very_high'">Very High</t>
                                    <t t-elif="risk.inherent_risk_rating == 'high'">High</t>
                                    <t t-elif="risk.inherent_risk_rating == 'medium'">Medium</t>
                                    <t t-elif="risk.inherent_risk_rating == 'low'">Low</t>
                                    <t t-elif="risk.inherent_risk_rating == 'very_low'">Very Low</t>
                                    (<t t-esc="risk.inherent_risk_score"/>)
                                </td>

                                <!-- Existing Mitigation/control -->
                                <td class="cell-left"><t t-esc="risk.existing_controls"/></td>

                                <!-- Adequacy (color-coded) -->
                                <t t-set="a_val" t-value="int(risk.control_adequacy) if risk.control_adequacy else 0"/>
                                <td class="cell-center" t-attf-style="background-color: {{risk.get_rating_color('adequacy')}}; color: {{risk.get_rating_text_color('adequacy')}}; font-weight: bold;">
                                    <t t-if="a_val == 5">Strong (5)</t>
                                    <t t-elif="a_val == 4">Acceptable (4)</t>
                                    <t t-elif="a_val == 3">Marginal (3)</t>
                                    <t t-elif="a_val == 2">Deficient (2)</t>
                                    <t t-elif="a_val == 1">Weak (1)</t>
                                </td>

                                <!-- Effectiveness (color-coded) -->
                                <t t-set="e_val" t-value="int(risk.control_effectiveness) if risk.control_effectiveness else 0"/>
                                <td class="cell-center" t-attf-style="background-color: {{risk.get_rating_color('effectiveness')}}; color: {{risk.get_rating_text_color('effectiveness')}}; font-weight: bold;">
                                    <t t-if="e_val == 5">Strong (5)</t>
                                    <t t-elif="e_val == 4">Acceptable (4)</t>
                                    <t t-elif="e_val == 3">Marginal (3)</t>
                                    <t t-elif="e_val == 2">Deficient (2)</t>
                                    <t t-elif="e_val == 1">Weak (1)</t>
                                </td>

                                <!-- Control strength (color-coded) -->
                                <td class="cell-center" t-attf-style="background-color: {{risk.get_rating_color('control')}}; color: {{risk.get_rating_text_color('control')}}; font-weight: bold;">
                                    <t t-if="risk.control_strength_rating == 'very_strong'">Very Strong</t>
                                    <t t-elif="risk.control_strength_rating == 'strong'">Strong</t>
                                    <t t-elif="risk.control_strength_rating == 'moderate'">Moderate</t>
                                    <t t-elif="risk.control_strength_rating == 'weak'">Weak</t>
                                    <t t-elif="risk.control_strength_rating == 'very_weak'">Very Weak</t>
                                    (<t t-esc="risk.control_strength_score"/>)
                                </td>

                                <!-- Residual Risk Rating (color-coded) -->
                                <td class="cell-center" t-attf-style="background-color: {{risk.get_rating_color('residual')}}; color: {{risk.get_rating_text_color('residual')}}; font-weight: bold;">
                                    <t t-if="risk.residual_risk_rating == 'very_high'">Very High</t>
                                    <t t-elif="risk.residual_risk_rating == 'high'">High</t>
                                    <t t-elif="risk.residual_risk_rating == 'medium'">Medium</t>
                                    <t t-elif="risk.residual_risk_rating == 'low'">Low</t>
                                    <t t-elif="risk.residual_risk_rating == 'very_low'">Very Low</t>
                                    (<t t-esc="'%.1f' % risk.residual_risk_score"/>)
                                </td>

                                <!-- Additional Mitigation/Control Action -->
                                <td class="cell-left"><t t-esc="risk.additional_mitigation"/></td>
                                
                                <!-- Key Risk Indicator (KRI) -->
                                <td class="cell-left"><t t-esc="risk.key_risk_indicator"/></td>
                                
                                <!-- Risk Owner (Departments) -->
                                <td class="cell-left">
                                    <t t-foreach="risk.risk_owner_ids" t-as="dept" t-key="dept.id">
                                        <t t-esc="dept.name"/><t t-if="not dept_last">, </t>
                                    </t>
                                    <t t-if="not risk.risk_owner_ids">
                                        <t t-esc="risk.department_id.name"/>
                                    </t>
                                </td>
                                
                                <!-- Progress (Status) -->
                                <td class="cell-center" style="text-transform: capitalize;">
                                    <t t-if="risk.status == 'open'">Open</t>
                                    <t t-elif="risk.status == 'in_progress'">In Progress</t>
                                    <t t-elif="risk.status == 'closed'">Closed</t>
                                    <t t-elif="risk.status == 'overdue'">Overdue</t>
                                </td>
                            </tr>
                            <t t-set="sr_no" t-value="sr_no + 1"/>
                        </t>
                    </tbody>
                </table>

                <!-- Signature Footer -->
                <table style="width: 100%; margin-top: 30px; border: none;">
                    <tr style="border: none;">
                        <td style="width: 50%; border: none; text-align: left; vertical-align: top;">
                            <div style="border-top: 1px solid #000; width: 220px; padding-top: 5px; font-size: 9px;">
                                <strong>Prepared By (Risk Maker):</strong><br/>
                                <t t-if="docs">
                                    <t t-esc="docs[0].risk_maker_id.name or ''"/>
                                </t>
                            </div>
                        </td>
                        <td style="width: 50%; border: none; text-align: right; vertical-align: top;">
                            <div style="border-top: 1px solid #000; width: 220px; float: right; padding-top: 5px; font-size: 9px;">
                                <strong>Verified By (Risk Checker):</strong><br/>
                                <t t-if="docs">
                                    <t t-esc="docs[0].checker_id.name or ''"/>
                                </t>
                            </div>
                        </td>
                    </tr>
                </table>

            </div>
        </t>
    </template>

</odoo>
