<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         paperformat — Landscape A4 with narrow margins
         ══════════════════════════════════════════════════════════════════ -->
    <record id="paperformat_risk_register_landscape" model="report.paperformat">
        <field name="name">Risk Register Landscape Format</field>
        <field name="default">True</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         ir.actions.report — Risk Register Landscape PDF Report
         ══════════════════════════════════════════════════════════════════ -->
    <record id="action_report_risk_register" model="ir.actions.report">
        <field name="name">Risk Register Report</field>
        <field name="model">risk.register</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ahadu_risk_register.report_risk_register_table_document</field>
        <field name="report_file">ahadu_risk_register.report_risk_register_table_document</field>
        <field name="print_report_name">'Risk_Register'</field>
        <field name="binding_model_id" ref="model_risk_register"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_risk_register_landscape"/>
    </record>

    <!-- Board Summary Report Action -->
    <record id="action_report_board_summary" model="ir.actions.report">
        <field name="name">Board Summary Report</field>
        <field name="model">risk.register</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ahadu_risk_register.report_board_summary_document</field>
        <field name="report_file">ahadu_risk_register.report_board_summary_document</field>
        <field name="print_report_name">'Board_Summary_Report'</field>
        <field name="binding_model_id" ref="model_risk_register"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_risk_register_landscape"/>
    </record>

</odoo>
