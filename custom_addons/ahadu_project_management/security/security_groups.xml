<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Security Category & Groups
         (no <data> wrapper — records go directly under <odoo>)
    ============================================================ -->

    <!-- Define Category -->
    <record id="module_category_ahadu_project" model="ir.module.category">
        <field name="name">Ahadu Bank Project Management</field>
        <field name="description">Access control groups for Ahadu Bank Project Management Customization</field>
        <field name="parent_id" ref="base.module_category_services"/>
        <field name="sequence">10</field>
    </record>

    <!-- Team Member Group -->
    <record id="group_project_team" model="res.groups">
        <field name="name">Team Member</field>
        <field name="category_id" ref="module_category_ahadu_project"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/>
    </record>

    <!-- Project Manager Group -->
    <record id="group_project_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="category_id" ref="module_category_ahadu_project"/>
        <field name="implied_ids" eval="[(4, ref('group_project_team')), (4, ref('project.group_project_manager'))]"/>
    </record>

    <!-- PMO Admin Group -->
    <record id="group_pmo_admin" model="res.groups">
        <field name="name">PMO Administrator</field>
        <field name="category_id" ref="module_category_ahadu_project"/>
        <field name="implied_ids" eval="[(4, ref('group_project_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
