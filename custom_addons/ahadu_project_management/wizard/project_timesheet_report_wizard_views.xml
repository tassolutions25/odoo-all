<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_project_timesheet_report_wizard_form" model="ir.ui.view">
        <field name="name">project.timesheet.report.wizard.form</field>
        <field name="model">project.timesheet.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Timesheet Report">
                <sheet>
                    <group>
                        <group string="Date Filters">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Other Filters">
                            <field name="department_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="project_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Report Options">
                            <field name="report_type" widget="radio"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_generate_report" string="Generate" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Wizard Window Action -->
    <record id="action_project_timesheet_report_wizard" model="ir.actions.act_window">
        <field name="name">Timesheets Report</field>
        <field name="res_model">project.timesheet.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
