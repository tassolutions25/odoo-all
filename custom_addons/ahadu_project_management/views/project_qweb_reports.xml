<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb PDF Report Registration -->
    <record id="action_report_project_dashboard_qweb" model="ir.actions.report">
        <field name="name">Project Portfolio PDF Report</field>
        <field name="model">project.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ahadu_project_management.rpt_project_dashboard</field>
        <field name="report_file">ahadu_project_management.rpt_project_dashboard</field>
        <field name="print_report_name">'Project_Report_%s' % (object.report_type)</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template Definition -->
    <template id="rpt_project_dashboard">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Inter', 'Outfit', sans-serif;">
                        <!-- Report Header -->
                        <div class="row text-center mb-4">
                            <div class="col-12">
                                <h2 style="color: #1f4e78; font-weight: bold; margin-bottom: 5px;">AHADU BANK S.C.</h2>
                                <h4 style="text-transform: uppercase; font-weight: bold; color: #555;">
                                    <t t-out="dict(doc._fields['report_type'].selection).get(doc.report_type)"/>
                                </h4>
                            </div>
                        </div>

                        <!-- Metadata Table -->
                        <table class="table table-sm table-borderless mb-4" style="font-size: 13px; background-color: #f8f9fa; border-radius: 4px; padding: 10px;">
                            <tr>
                                <td><strong>Reporting Period:</strong></td>
                                <td><span t-out="doc.date_from"/> to <span t-out="doc.date_to"/></td>
                                <td><strong>Report Date:</strong></td>
                                <td><span t-out="datetime.date.today().strftime('%Y-%m-%d')"/></td>
                            </tr>
                            <tr>
                                <td><strong>Generated By:</strong></td>
                                <td><span t-out="doc.env.user.name"/></td>
                                <td><strong>Generated On:</strong></td>
                                <td><span t-out="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/></td>
                            </tr>
                        </table>

                        <t t-set="projects" t-value="doc_projects[doc.id]"/>

                        <!-- ============================================== -->
                        <!-- 1. Executive Management Layout -->
                        <!-- ============================================== -->
                        <t t-if="doc.report_type == 'executive'">
                            <!-- Portfolio Summary -->
                            <h5 style="background-color: #2f5597; color: #fff; padding: 6px; font-weight: bold; border-radius: 2px;">1. Portfolio Summary</h5>
                            <table class="table table-bordered table-sm mb-4" style="font-size: 11px;">
                                <thead>
                                    <tr class="table-active">
                                        <th>Code</th>
                                        <th>Project Name</th>
                                        <th>Sponsor</th>
                                        <th>Directorate</th>
                                        <th>PM</th>
                                        <th class="text-center">Progress</th>
                                        <th class="text-right">Budget</th>
                                        <th class="text-center">Health</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="projects" t-as="p">
                                        <tr>
                                            <td><span t-out="p.project_code"/></td>
                                            <td><strong><span t-out="p.name"/></strong></td>
                                            <td><span t-out="p.project_sponsor_id.name"/></td>
                                            <td><span t-out="p.project_department_id.name"/></td>
                                            <td><span t-out="p.user_id.name"/></td>
                                            <td class="text-center"><span t-out="'%.1f' % p.project_progress"/>%</td>
                                            <td class="text-right"><span t-out="'{:,.2f}'.format(p.budget_amount)"/></td>
                                            <td class="text-center">
                                                <span t-if="p.project_health == 'green'" class="badge badge-success" style="background-color: #28a745; color: #fff; padding: 4px;">On Track</span>
                                                <span t-elif="p.project_health == 'amber'" class="badge badge-warning" style="background-color: #ffc107; color: #000; padding: 4px;">At Risk</span>
                                                <span t-elif="p.project_health == 'red'" class="badge badge-danger" style="background-color: #dc3545; color: #fff; padding: 4px;">Critical</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- Budget & Variance -->
                            <h5 style="background-color: #2f5597; color: #fff; padding: 6px; font-weight: bold; border-radius: 2px;">2. Budget Summary &amp; Variance Analysis</h5>
                            <table class="table table-bordered table-sm mb-4" style="font-size: 11px;">
                                <thead>
                                    <tr class="table-active">
                                        <th>Project</th>
                                        <th class="text-right">Planned Budget</th>
                                        <th class="text-right">Actual Cost</th>
                                        <th class="text-right">Variance</th>
                                        <th class="text-center">Utilization</th>
                                        <th class="text-center">Budget Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="projects" t-as="p">
                                        <tr>
                                            <td><span t-out="p.name"/></td>
                                            <td class="text-right"><span t-out="'{:,.2f}'.format(p.budget_amount)"/></td>
                                            <td class="text-right"><span t-out="'{:,.2f}'.format(p.actual_cost)"/></td>
                                            <td class="text-right"><span t-out="'{:,.2f}'.format(p.budget_variance)"/></td>
                                            <td class="text-center"><span t-out="'%.1f' % ((p.actual_cost / p.budget_amount * 100) if p.budget_amount > 0 else 0)"/>%</td>
                                            <td class="text-center">
                                                <span t-if="p.budget_status == 'exceeded'" class="text-danger" style="font-weight: bold;">EXCEEDED</span>
                                                <span t-else="" class="text-success">ON TRACK</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- ============================================== -->
                        <!-- 2. Project Sponsor Layout -->
                        <!-- ============================================== -->
                        <t t-elif="doc.report_type == 'sponsor'">
                            <h5 style="background-color: #2f5597; color: #fff; padding: 6px; font-weight: bold; border-radius: 2px;">Sponsored Projects Portfolio</h5>
                            <table class="table table-bordered table-sm mb-4" style="font-size: 11px;">
                                <thead>
                                    <tr class="table-active">
                                        <th>Project Name</th>
                                        <th>Project Manager</th>
                                        <th class="text-center">Progress</th>
                                        <th class="text-right">Budget</th>
                                        <th class="text-center">Health</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="projects" t-as="p">
                                        <tr>
                                            <td><span t-out="p.name"/></td>
                                            <td><span t-out="p.user_id.name"/></td>
                                            <td class="text-center"><span t-out="'%.1f' % p.project_progress"/>%</td>
                                            <td class="text-right"><span t-out="'{:,.2f}'.format(p.budget_amount)"/></td>
                                            <td class="text-center"><span t-out="p.project_health"/></td>
                                            <td class="text-center"><span t-out="p.state"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- ============================================== -->
                        <!-- 3. IT PMO Department Layout -->
                        <!-- ============================================== -->
                        <t t-elif="doc.report_type == 'pmo'">
                            <h5 style="background-color: #2f5597; color: #fff; padding: 6px; font-weight: bold; border-radius: 2px;">Division &amp; Performance Rollup</h5>
                            <table class="table table-bordered table-sm mb-4" style="font-size: 11px;">
                                <thead>
                                    <tr class="table-active">
                                        <th>Project Name</th>
                                        <th>Division</th>
                                        <th>Sponsor</th>
                                        <th>PM</th>
                                        <th class="text-center">Progress</th>
                                        <th class="text-right">Budget</th>
                                        <th class="text-center">Health</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="projects" t-as="p">
                                        <tr>
                                            <td><span t-out="p.name"/></td>
                                            <td><span t-out="p.project_division_id.name"/></td>
                                            <td><span t-out="p.project_sponsor_id.name"/></td>
                                            <td><span t-out="p.user_id.name"/></td>
                                            <td class="text-center"><span t-out="'%.1f' % p.project_progress"/>%</td>
                                            <td class="text-right"><span t-out="'{:,.2f}'.format(p.budget_amount)"/></td>
                                            <td class="text-center"><span t-out="p.project_health"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- ============================================== -->
                        <!-- 4. EPAD Division Layout -->
                        <!-- ============================================== -->
                        <t t-elif="doc.report_type == 'division'">
                            <h5 style="background-color: #2f5597; color: #fff; padding: 6px; font-weight: bold; border-radius: 2px;">Execution and Milestones Progress</h5>
                            <table class="table table-bordered table-sm mb-4" style="font-size: 11px;">
                                <thead>
                                    <tr class="table-active">
                                        <th>Project Name</th>
                                        <th>PM</th>
                                        <th class="text-center">Phases Count</th>
                                        <th class="text-center">Overdue Tasks</th>
                                        <th class="text-right">Budget</th>
                                        <th class="text-center">Health</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="projects" t-as="p">
                                        <tr>
                                            <td><span t-out="p.name"/></td>
                                            <td><span t-out="p.user_id.name"/></td>
                                            <td class="text-center"><span t-out="len(p.phase_ids)"/></td>
                                            <td class="text-center"><span t-out="p.overdue_tasks_count"/></td>
                                            <td class="text-right"><span t-out="'{:,.2f}'.format(p.budget_amount)"/></td>
                                            <td class="text-center"><span t-out="p.project_health"/></td>
                                            <td class="text-center"><span t-out="p.state"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- ============================================== -->
                        <!-- 5. Project Manager Layout -->
                        <!-- ============================================== -->
                        <t t-elif="doc.report_type == 'pm'">
                            <t t-foreach="projects" t-as="p">
                                <h5 style="background-color: #2f5597; color: #fff; padding: 6px; font-weight: bold; border-radius: 2px;">Project: <span t-out="p.name"/> (<span t-out="p.project_code"/>)</h5>
                                <table class="table table-bordered table-sm mb-4" style="font-size: 11px;">
                                    <thead>
                                        <tr class="table-active">
                                            <th>Task Name</th>
                                            <th>Assigned Resource</th>
                                            <th>Planned End Date</th>
                                            <th class="text-center">Progress</th>
                                            <th class="text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="p.task_ids" t-as="t">
                                            <tr>
                                                <td><span t-out="t.name"/></td>
                                                <td><span t-out="', '.join(t.user_ids.mapped('name'))"/></td>
                                                <td><span t-out="t.planned_end_date"/></td>
                                                <td class="text-center"><span t-out="t.completion_percentage"/>%</td>
                                                <td class="text-center"><span t-out="t.task_status"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>

                        <!-- ============================================== -->
                        <!-- 6. Team Member Layout -->
                        <!-- ============================================== -->
                        <t t-elif="doc.report_type == 'team'">
                            <h5 style="background-color: #2f5597; color: #fff; padding: 6px; font-weight: bold; border-radius: 2px;">My Assigned Tasks</h5>
                            <table class="table table-bordered table-sm mb-4" style="font-size: 11px;">
                                <thead>
                                    <tr class="table-active">
                                        <th>Task Name</th>
                                        <th>Project</th>
                                        <th>Priority</th>
                                        <th>Deadline</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="my_tasks" t-value="doc.env['project.task'].search([('project_id', 'in', projects.ids), ('user_ids', 'in', [doc.env.user.id])])"/>
                                    <t t-foreach="my_tasks" t-as="t">
                                        <tr>
                                            <td><span t-out="t.name"/></td>
                                            <td><span t-out="t.project_id.name"/></td>
                                            <td><span t-out="t.priority"/></td>
                                            <td><span t-out="t.planned_end_date"/></td>
                                            <td class="text-center"><span t-out="t.task_status"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Document Footer Classification Block -->
                        <div class="footer mt-5 pt-3" style="border-top: 1px solid #ccc; font-size: 10px; color: #666; font-style: italic;">
                            <div class="row">
                                <div class="col-4">System: Ahadu Project Management System</div>
                                <div class="col-4 text-center">Owner: Enterprise PMO</div>
                                <div class="col-4 text-right">Classification: Confidential - Ahadu Bank Internal</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
