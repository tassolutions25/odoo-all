<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Task Form View Customization
         ============================================================ -->
    <record id="view_task_form2_inherit_ahadu" model="ir.ui.view">
        <field name="name">project.task.form.inherit.ahadu</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <!-- 1. Hide native personal stages widget in the header -->
            <xpath expr="//field[@name='personal_stage_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 2. Hide native stage duration widget in the header -->
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 3. Add custom clickable status bar for task_status in the header -->
            <xpath expr="//header" position="inside">
                <field name="task_status" widget="statusbar" options="{'clickable': '1'}"
                       statusbar_visible="not_started,assigned,in_progress,pending,completed,cancelled"/>
            </xpath>

            <!-- 4. Hide native state selection widget next to title -->
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 5. Replace title div to make ID and Name fields standard size and show priority -->
            <xpath expr="//div[hasclass('oe_title')]" position="replace">
                <group>
                    <group>
                        <field name="task_number" readonly="1" string="Task ID"/>
                        <field name="name" string="Task Name" required="1"/>
                    </group>
                    <group>
                        <field name="priority" string="Priority"/>
                    </group>
                </group>
            </xpath>

            <!-- 6. Hide native deadline label and field -->
            <xpath expr="//label[@for='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@id='date_deadline_and_recurring_task']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 7. Add Planned Dates right after Assignees (user_ids) -->
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="planned_start_date" required="1"/>
                <field name="planned_end_date" required="1" string="Planned End Date"/>
            </xpath>

            <!-- 8. Inject WBS Phase selection right after milestone_id -->
            <xpath expr="//field[@name='milestone_id']" position="after">
                <field name="phase_id"
                       domain="[('project_id', '=', project_id)]"
                       context="{'default_project_id': project_id}"
                       placeholder="Select Phase..."
                       invisible="not project_id"/>
            </xpath>

            <!-- 9. Add resource allocation after allocated_hours -->
            <xpath expr="//field[@name='allocated_hours']" position="after">
                <field name="resource_allocation" string="Workload Allocation (%)"
                       help="Percentage of this assignee's capacity consumed by this task."/>
            </xpath>

            <!-- 10. Replace Execution Tracking Page with customized date & roll-up display -->
            <xpath expr="//notebook" position="inside">
                <page name="execution_tracking" string="Execution Tracking">
                    <group>
                        <group string="Planned Timeline">
                            <field name="planned_start_date" readonly="1"/>
                            <field name="planned_end_date" string="Planned End Date" readonly="1"/>
                            <field name="is_overdue" readonly="1"/>
                        </group>
                        <group string="Actual Execution">
                            <field name="actual_start_date"/>
                            <field name="actual_end_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Progress">
                            <field name="completion_percentage" widget="progressbar"/>
                            <field name="effective_hours" string="Approved Hours Logged"/>
                        </group>
                        <group string="WBS Reference">
                            <field name="task_number" readonly="1"/>
                            <field name="phase_id" readonly="1"
                                   domain="[('project_id', '=', project_id)]"
                                   invisible="not project_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================
         Task List View Customization
         ============================================================ -->
    <record id="view_task_tree2_inherit_ahadu" model="ir.ui.view">
        <field name="name">project.task.list.inherit.ahadu</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <!-- Set entire row red if the task is overdue -->
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">is_overdue == True</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="before">
                <field name="task_number" optional="show" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='date_deadline']" position="replace">
                <field name="planned_start_date" optional="show"/>
                <field name="planned_end_date" string="Planned End Date" optional="show"/>
                <field name="is_overdue" column_invisible="True"/>
            </xpath>

            <xpath expr="//field[@name='planned_end_date']" position="after">
                <field name="phase_id" optional="show"/>
                <field name="task_status" optional="show" widget="badge"
                       decoration-info="task_status == 'assigned'"
                       decoration-warning="task_status == 'in_progress'"
                       decoration-danger="task_status == 'pending'"
                       decoration-success="task_status == 'completed'"
                       decoration-muted="task_status in ['cancelled', 'not_started']"/>
                <field name="completion_percentage" optional="show" widget="progressbar"/>
                <field name="actual_start_date" optional="hide"/>
                <field name="actual_end_date" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
