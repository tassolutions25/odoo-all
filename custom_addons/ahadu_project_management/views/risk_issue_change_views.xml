<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Risk Views -->
    <record id="view_project_risk_tree" model="ir.ui.view">
        <field name="name">project.risk.tree</field>
        <field name="model">project.risk</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="owner_id"/>
                <field name="probability"/>
                <field name="impact"/>
                <field name="rating"/>
                <field name="rating_level" widget="badge" decoration-success="rating_level == 'low'" decoration-info="rating_level == 'medium'" decoration-warning="rating_level == 'high'" decoration-danger="rating_level == 'critical'"/>
                <field name="state" widget="badge" decoration-danger="state == 'open'" decoration-warning="state == 'mitigated'" decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_project_risk_form" model="ir.ui.view">
        <field name="name">project.risk.form</field>
        <field name="model">project.risk</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_escalate" string="Escalate Risk" type="object"
                        invisible="rating_level not in ('high', 'critical') or escalation_triggered"
                        class="oe_highlight"
                        groups="ahadu_project_management.group_project_manager,ahadu_project_management.group_pmo_admin"/>
                    <button name="action_mitigate" string="Mark as Mitigated" type="object"
                        invisible="state != 'open'"
                        groups="ahadu_project_management.group_project_manager,ahadu_project_management.group_pmo_admin"/>
                    <button name="action_close_risk" string="Close Risk" type="object"
                        invisible="state not in ('open', 'mitigated')"
                        class="oe_highlight"
                        groups="ahadu_project_management.group_project_manager,ahadu_project_management.group_pmo_admin"/>
                    <button name="action_reopen" string="Reopen" type="object"
                        invisible="state not in ('mitigated', 'closed')"
                        groups="ahadu_project_management.group_pmo_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,mitigated,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Describe the risk..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="owner_id" widget="many2one_avatar"/>
                            <field name="escalation_triggered" readonly="1"/>
                        </group>
                        <group string="Risk Assessment">
                            <field name="probability"/>
                            <field name="impact"/>
                            <field name="rating" readonly="1"/>
                            <field name="rating_level" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mitigation Plan" name="mitigation">
                            <field name="mitigation_plan" placeholder="Details of the risk mitigation plan..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_project_risk_search" model="ir.ui.view">
        <field name="name">project.risk.search</field>
        <field name="model">project.risk</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <filter string="Open Risks" name="open_risks" domain="[('state', '=', 'open')]"/>
                <filter string="High &amp; Critical" name="high_risks" domain="[('rating_level', 'in', ['high', 'critical'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Risk Level" name="group_by_rating_level" context="{'group_by': 'rating_level'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Issue Views -->
    <record id="view_project_issue_tree" model="ir.ui.view">
        <field name="name">project.issue.tree</field>
        <field name="model">project.issue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="owner_id"/>
                <field name="severity" widget="badge" decoration-success="severity == 'low'" decoration-info="severity == 'medium'" decoration-warning="severity == 'high'" decoration-danger="severity == 'critical'"/>
                <field name="date_identified"/>
                <field name="escalated" widget="boolean_toggle"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-danger="state == 'open'" decoration-warning="state == 'resolved'" decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_project_issue_form" model="ir.ui.view">
        <field name="name">project.issue.form</field>
        <field name="model">project.issue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" string="Open Issue" type="object"
                        invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_escalate" string="Escalate to Sponsor" type="object"
                        invisible="state != 'open' or escalated" class="oe_highlight"
                        groups="ahadu_project_management.group_project_manager,ahadu_project_management.group_pmo_admin"/>
                    <button name="action_resolve" string="Resolve" type="object"
                        invisible="state != 'open'" class="oe_highlight"/>
                    <button name="action_close" string="Close Issue" type="object"
                        invisible="state != 'resolved'" class="oe_highlight"
                        groups="ahadu_project_management.group_project_manager,ahadu_project_management.group_pmo_admin"/>
                    <button name="action_reopen_issue" string="Reopen" type="object"
                        invisible="state not in ('resolved', 'closed')"
                        groups="ahadu_project_management.group_pmo_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Issue Roadblock Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="owner_id" widget="many2one_avatar"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="date_identified" readonly="state in ('resolved', 'closed')"/>
                            <field name="date_resolved" readonly="1"/>
                            <field name="escalated" readonly="1"/>
                            <field name="escalated_to_id" widget="many2one_avatar" readonly="escalated or state in ('resolved', 'closed')"/>
                            <field name="escalation_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Issue Description">
                        <field name="description" placeholder="Describe the roadblock or conflict..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_project_issue_search" model="ir.ui.view">
        <field name="name">project.issue.search</field>
        <field name="model">project.issue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <filter string="Open Issues" name="open_issues" domain="[('state', 'in', ['draft', 'open'])]"/>
                <filter string="Escalated" name="escalated" domain="[('escalated', '=', True)]"/>
                <filter string="Critical" name="critical" domain="[('severity', '=', 'critical')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Severity" name="group_by_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Issue Kanban View -->
    <record id="view_project_issue_kanban" model="ir.ui.view">
        <field name="name">project.issue.kanban</field>
        <field name="model">project.issue</field>
        <field name="arch" type="xml">
            <kanban default_group_by="severity" class="o_kanban_mobile">
                <field name="name"/>
                <field name="project_id"/>
                <field name="owner_id"/>
                <field name="severity"/>
                <field name="state"/>
                <field name="escalated"/>
                <field name="date_identified"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.escalated.raw_value ? 'border-danger' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="severity" widget="badge"
                                        decoration-success="severity == 'low'"
                                        decoration-info="severity == 'medium'"
                                        decoration-warning="severity == 'high'"
                                        decoration-danger="severity == 'critical'"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <span class="text-muted">
                                        <i class="fa fa-briefcase"/> <field name="project_id"/>
                                    </span>
                                    <br/>
                                    <span class="text-muted">
                                        <i class="fa fa-calendar"/> <field name="date_identified"/>
                                    </span>
                                    <t t-if="record.escalated.raw_value">
                                        <span class="badge bg-danger ms-1">Escalated</span>
                                    </t>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <field name="owner_id" widget="many2one_avatar_user"/>
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-danger="state == 'open'"
                                        decoration-warning="state == 'resolved'"
                                        decoration-success="state == 'closed'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Change Request Type Views -->
    <record id="view_project_change_request_type_tree" model="ir.ui.view">
        <field name="name">project.change_request.type.tree</field>
        <field name="model">project.change_request.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="sequence"/>
                <field name="system_action"/>
            </list>
        </field>
    </record>

    <record id="view_project_change_request_type_form" model="ir.ui.view">
        <field name="name">project.change_request.type.form</field>
        <field name="model">project.change_request.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="system_action"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_change_request_type" model="ir.actions.act_window">
        <field name="name">Change Request Types</field>
        <field name="res_model">project.change_request.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Change Request Views -->

    <record id="view_project_change_request_tree" model="ir.ui.view">
        <field name="name">project.change_request.tree</field>
        <field name="model">project.change_request</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="change_type_id"/>
                <field name="requested_by_id"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-warning="state in ['reviewed', 'approved']" decoration-success="state in ['implemented', 'closed']" decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_project_change_request_form" model="ir.ui.view">
        <field name="name">project.change_request.form</field>
        <field name="model">project.change_request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit Request" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_review" string="Review Request" type="object" invisible="state != 'submitted'" class="oe_highlight" groups="ahadu_project_management.group_project_manager,ahadu_project_management.group_pmo_admin"/>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'reviewed'" class="oe_highlight" groups="ahadu_project_management.group_project_manager,ahadu_project_management.group_pmo_admin"/>
                    <button name="action_implement" string="Mark as Implemented" type="object" invisible="state != 'approved'" class="oe_highlight" groups="ahadu_project_management.group_project_manager,ahadu_project_management.group_pmo_admin"/>
                    <button name="action_close" string="Close CR" type="object" invisible="state != 'implemented'" groups="ahadu_project_management.group_project_manager,ahadu_project_management.group_pmo_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,reviewed,approved,implemented,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Change Request Title..."/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True, 'no_edit': True}" readonly="state != 'draft'"/>
                            <field name="change_type_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="system_action" invisible="1"/>
                            <field name="requested_by_id" widget="many2one_avatar"/>
                        </group>
                        <group string="Impact Adjustments">
                            <field name="proposed_budget_change" invisible="system_action != 'budget'" required="system_action == 'budget'" readonly="state != 'draft'"/>
                            <field name="proposed_timeline_change" invisible="system_action != 'timeline'" required="system_action == 'timeline'" readonly="state != 'draft'"/>
                            <field name="reviewed_by_id" widget="many2one_avatar"/>
                            <field name="approved_by_id" widget="many2one_avatar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description of Change" name="description">
                            <field name="description" placeholder="Describe the modification needed..."/>
                        </page>
                        <page string="Impact Assessment" name="impact">
                            <field name="impact_assessment" placeholder="Analyze the impact on cost, scope, timeline, quality..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_project_change_request_search" model="ir.ui.view">
        <field name="name">project.change_request.search</field>
        <field name="model">project.change_request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="project_id"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Pending Approval" name="pending" domain="[('state', 'in', ['submitted', 'reviewed'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Change Type" name="group_by_change_type" context="{'group_by': 'change_type_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Project Form View Customization: Risks, Issues, Change Requests Tabs -->
    <record id="edit_project_inherit_governance" model="ir.ui.view">
        <field name="name">project.project.form.inherit.governance</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="ahadu_project_management.edit_project_inherit_budget"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='project_expenses']" position="after">
                <page string="Risks Register" name="project_risks">
                    <field name="risk_ids" context="{'default_project_id': id}">
                        <list>
                            <field name="name"/>
                            <field name="owner_id"/>
                            <field name="probability"/>
                            <field name="impact"/>
                            <field name="rating"/>
                            <field name="rating_level" widget="badge"
                                decoration-success="rating_level == 'low'"
                                decoration-info="rating_level == 'medium'"
                                decoration-warning="rating_level == 'high'"
                                decoration-danger="rating_level == 'critical'"/>
                            <field name="state" widget="badge"
                                decoration-danger="state == 'open'"
                                decoration-warning="state == 'mitigated'"
                                decoration-success="state == 'closed'"/>
                        </list>
                    </field>
                </page>
                <page string="Issues &amp; Roadblocks" name="project_issues">
                    <field name="issue_ids" context="{'default_project_id': id}">
                        <list>
                            <field name="name"/>
                            <field name="owner_id"/>
                            <field name="severity" widget="badge"
                                decoration-success="severity == 'low'"
                                decoration-info="severity == 'medium'"
                                decoration-warning="severity == 'high'"
                                decoration-danger="severity == 'critical'"/>
                            <field name="date_identified"/>
                            <field name="escalated"/>
                            <field name="state" widget="badge"
                                decoration-info="state == 'draft'"
                                decoration-danger="state == 'open'"
                                decoration-warning="state == 'resolved'"
                                decoration-success="state == 'closed'"/>
                        </list>
                    </field>
                </page>
                <page string="Change Requests" name="project_change_requests">
                    <field name="change_request_ids" context="{'default_project_id': id}">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="change_type_id"/>
                            <field name="requested_by_id"/>
                            <field name="state" widget="badge"
                                decoration-muted="state == 'draft'"
                                decoration-info="state == 'submitted'"
                                decoration-warning="state in ('reviewed', 'approved')"
                                decoration-success="state in ('implemented', 'closed')"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

