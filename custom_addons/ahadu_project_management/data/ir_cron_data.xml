<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_check_overdue_tasks" model="ir.cron">
        <field name="name">Project Task: Check Overdue Tasks</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_overdue_tasks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Cron: Escalate critical issues unresolved for > 48 hours -->
    <record id="ir_cron_escalate_critical_issues" model="ir.cron">
        <field name="name">Project Issue: Escalate Critical Roadblocks</field>
        <field name="model_id" ref="model_project_issue"/>
        <field name="state">code</field>
        <field name="code">model._cron_escalate_critical_issues()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Cron: Send milestone reminders 5 days before deadline -->
    <record id="ir_cron_send_milestone_reminders" model="ir.cron">
        <field name="name">Project Milestone: Upcoming Milestone Reminders</field>
        <field name="model_id" ref="model_project_milestone"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_milestone_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

