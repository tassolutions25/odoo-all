<odoo>
    <data>
        <record id="hr_recruitment_stage_view_form_inherit_approval" model="ir.ui.view">
            <field name="name">hr.recruitment.stage.form.inherit.approval</field>
            <field name="model">hr.recruitment.stage</field>
            <field name="inherit_id" ref="hr_recruitment.hr_recruitment_stage_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='hired_stage']" position="after">
                    <field name="requires_manager_approval"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>